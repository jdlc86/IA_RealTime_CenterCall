{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ia-realtime-centercall",
  "main": "src/index-v2.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "vars": {
    "ENVIRONMENT": "dev",
    "REALTIME_MODEL": "gpt-realtime",
    "REALTIME_VOICE": "marin",
    "OPENAI_PROJECT_ID": "proj_sRULdPh5pWmKIg59z6J01QI9",
    "DEBUG_KEY": "false"
  },
  "kv_namespaces": [
    {
      "binding": "TENANT_CONFIG"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CALL_SESSIONS",
        "class_name": "CallSession"
      }
    ]
  },
  "exports": {
    "CallSession": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
