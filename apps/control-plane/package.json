{
  "name": "@ia-realtime-centercall/control-plane",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.2",
  "scripts": {
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run",
    "types": "wrangler types --include-runtime=false",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:build": "node -e \"require('node:fs').rmSync('.test-dist',{recursive:true,force:true})\" && tsc -p tsconfig.test-build.json",
    "pretest": "npm run types && npm run typecheck && npm run test:build",
    "check": "wrangler deploy --dry-run",
    "test": "node --experimental-specifier-resolution=node --test src/*.test.mjs"
  },
  "dependencies": {
    "openai": "^7.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260821.1",
    "typescript": "^5.9.0",
    "wrangler": "^4.0.0"
  }
}
