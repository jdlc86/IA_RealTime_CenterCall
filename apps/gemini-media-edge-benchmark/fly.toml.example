# Copy to fly.toml and set a unique app name before deployment.
app = "REPLACE_ME"
primary_region = "cdg"

[build]
  dockerfile = "Dockerfile"

[http_service]
  internal_port = 8080
  force_https = true
  auto_stop_machines = "off"
  auto_start_machines = false
  min_machines_running = 1

  [http_service.concurrency]
    type = "connections"
    soft_limit = 25
    hard_limit = 25

[[vm]]
  size = "performance-1x"
  memory = "2gb"
